# AbangTa 1.0 — Environment Variables
# Copy this file to .env and .env.local; keep their values consistent.
# Never commit .env.local to version control.

# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
# MySQL 8+ connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://abangta:your_password@localhost:3306/abangta_db"

# ─────────────────────────────────────────────
# AUTHENTICATION
# ─────────────────────────────────────────────
# NextAuth.js v5 secret — generate with: openssl rand -base64 32
AUTH_SECRET="your-nextauth-secret-here"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional public business contact details and official social profile URLs.
# Empty values stay inactive. Use HTTPS links to your own pages.
ABANGTA_CONTACT_EMAIL=""
ABANGTA_CONTACT_PHONE=""
ABANGTA_FACEBOOK_URL=""
ABANGTA_TIKTOK_URL=""
ABANGTA_INSTAGRAM_URL=""

# Automatic in-app reminders run with npm dev/start. Leave the optional secret
# empty to generate it privately in memory; use 32+ characters for external cron.
# Never expose this secret publicly or in a URL. Set AUTOMATIC=0 to opt out.
BILL_REMINDERS_SECRET=""
BILL_REMINDERS_AUTOMATIC="1"

# ─────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────
# Public URL of the application (used for invite links, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Ishi uses (internal NADINE_* configuration names are retained):
# Ishi uses verified records without AI by default. Optional server-only intent routing:
# Never prefix these credentials with NEXT_PUBLIC_. See docs/NADINE-ASSISTANT.md.
NADINE_AI_PROVIDER=""
NADINE_AI_MODEL=""
OPENAI_API_KEY=""
